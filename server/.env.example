# THREAD server environment (phase 1)
# Copy to .env and fill in. Required keys must be set or the server refuses to start.

# ---- required ----
PORT=5000
HOST_URL=http://localhost:5000
# CORS whitelist (JSON array or comma-separated). Put the Vite dev origin here.
# When the storefront is deployed, add its exact origin too, for example:
#   CORS_ORIGINS=["http://localhost:5173","https://your-storefront.example.com"]
#   CORS_ORIGINS=http://localhost:5173,https://your-storefront.example.com
# No trailing slash. In production, "*" is ignored because auth uses cookies.
# Owner: Rahul (@rahulgheek) - see docs/CORS.md
CORS_ORIGINS=["http://localhost:5173"]
CLIENT_URL=http://localhost:5173

# local dev values below. For cloud / small-host deployments put a MongoDB Atlas
# SRV URI (mongodb+srv://<user>:<pass>@<cluster>/thread) in MONGO_URI and a
# cloud/private Redis URL in REDIS_URL. Elasticsearch is OPTIONAL: when
# ELASTIC_NODE is unreachable, q search + facets are served straight from Mongo.
MONGO_URI=mongodb://localhost:27017/thread?replicaSet=rs0
REDIS_URL=redis://localhost:6379
ELASTIC_NODE=http://localhost:9200
# Only used when Node's resolver is stuck on a dead loopback (stale proxy/VPN) and
# mongodb+srv lookups fail with querySrv ECONNREFUSED. Comma-separated, first wins.
# DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string

# ---- optional (feature degrades gracefully if omitted) ----
# Google OAuth (console.cloud.google.com > Credentials > OAuth client, type Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ---- email (optional) ----
# SMTP is used when host + username + password are set. Works with any provider, e.g.
# Brevo relay (smtp-relay.brevo.com / 587) or Gmail (app password). MAIL_FROM must be a
# sender the provider allows; display name optional: `THREAD <no-reply@example.com>`.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=THREAD <no-reply@thread.dev>

# Fallback when SMTP is not configured: Brevo transactional API key (xkeysib-...).
# With neither SMTP nor this key, dev emails are printed to the server console.
BREVO_API_KEY=

# Seeder (admin-only): `npm run seed` upserts exactly one account - the staff admin below.
# The product catalogue is NOT touched by the seeder (it already lives on the database).
SEED_ADMIN_EMAIL=thread.admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---- dynamic image storage (admin product uploads) ----
# When all three values are set, admin-uploaded product images go to Cloudinary and
# the API answers with absolute https URLs. Unset = local server/uploads fallback.
# Static landing-page imagery is NOT uploaded - it lives in client/public/landing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=thread/products

# ---- payments (Razorpay test mode) ----
# Keys: dash.razorpay.com > Settings > API Keys. The KEY SECRET stays server-side only - the
# browser receives just the public key id and the gateway order id. With no keys set, online
# checkout answers 503 and the storefront stays COD-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook: dash.razorpay.com > Settings > Webhooks > URL http(s)://<your-host>/api/payments/razorpay/webhook
# (subscribe to payment.captured, payment.failed, order.paid) and paste the SAME secret here.
RAZORPAY_WEBHOOK_SECRET=