# THREAD client environment (local development)
# Copy to .env for your machine. .env is gitignored; this example is committed.

# Origin of the API the browser calls. The server whitelists this origin through
# CORS_ORIGINS in server/.env, so both values must match.
VITE_API_URL=http://localhost:5000

# Public origin of this storefront.
VITE_CLIENT_URL=http://localhost:5173

# Deployed example:
# VITE_API_URL=https://thread-api.example.com
# VITE_CLIENT_URL=https://thread-store.example.com
